{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "server:build",
            "type": "shell",
            "command": "${workspaceFolder}/../third-party/go/bin/go",
            "args": [
                "build",
                "-o",
                "${workspaceFolder}/.install/bin/server",
                "./cmd/server"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$go"
            ],
            "group": "build"
        },
        {
            "label": "server:test",
            "type": "shell",
            "command": "${workspaceFolder}/../third-party/go/bin/go",
            "args": [
                "test",
                "./..."
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$go"
            ],
            "group": "test"
        },
        {
            "label": "sqlite:migrate",
            "type": "shell",
            "command": "${workspaceFolder}/../cmd/sqlite.sh",
            "args": [
                "migrate"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "garage:start",
            "type": "shell",
            "command": "../cmd/garage.sh",
            "args": [
                "start"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "garage-logs",
                "pattern": [
                    {
                        "regexp": ".*"
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*"
                }
            }
        }
    ]
}