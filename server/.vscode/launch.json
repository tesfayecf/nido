{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "server:debug",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/server",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "GOTOOLCHAIN": "local",
                "HS_HTTP_ADDR": ":8080",
                "HS_OBJECT_STORE_DRIVER": "memory",
                "HS_BOOTSTRAP_ADMIN_EMAIL": "admin@local",
                "HS_BOOTSTRAP_ADMIN_PASSWORD": "dev-password"
            },
            "preLaunchTask": "sqlite:migrate"
        }
    ]
}